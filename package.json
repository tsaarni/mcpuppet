{
  "name": "mcpuppet",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "bin": {
    "mcpuppet-cli": "./dist/mcpuppet-cli"
  },
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-path=src --strip-types --env-file=.env.example src/main.ts",
    "start": "node --strip-types src/main.ts",
    "cli": "node --strip-types src/cli.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && esbuild src/main.ts --bundle --platform=node --format=esm --external:chrome-devtools-mcp --banner:js='#!/usr/bin/env node\nimport{createRequire}from\"module\";const require=createRequire(import.meta.url);' --outfile=dist/mcpuppet-server && esbuild src/cli.ts --bundle --platform=node --format=esm --banner:js='#!/usr/bin/env node' --outfile=dist/mcpuppet-cli && chmod +x dist/mcpuppet-server dist/mcpuppet-cli",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "test": "node --strip-types --test test/**/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mozilla/readability": "^0.6.0",
    "async-mutex": "^0.5.0",
    "chrome-devtools-mcp": "^1.9.0",
    "hono": "^4.13.7",
    "linkedom": "^0.18.13",
    "puppeteer": "^25.10.0",
    "turndown": "^7.2.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/mozilla__readability": "^0.4.2",
    "@types/node": "^26.5.0",
    "@types/turndown": "^5.0.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
